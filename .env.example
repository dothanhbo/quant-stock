# Quant Stock environment template (names only; NO real values here).
# Copy to `.env` (gitignored) and fill in locally / on the VPS.
# Every line is commented out on purpose: an empty `NAME=` is NOT "unset"
# (several parsers then fail on float("")). Uncomment only what you set.
# Leaving a variable unset uses the code default. Defaults are documented in
# README.md "Configuration" and in the modules named below.
#
# WARNING: values under "Strategy / execution policy" change trading
# semantics. The V2 (Q70_FROZEN) and V3 wrappers in scripts/ overwrite several
# of them in-process before scanning; do not use .env to relabel a different
# policy as Q70 or V3.

# --- Secrets (never commit) -------------------------------------------------
# TELEGRAM_TOKEN=
# CHAT_ID=
# Optional AI explanation (explanatory only; cannot alter decisions)
# AI_ANALYSIS_ENABLED=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_API_BASE_URL=
# AI_ANALYSIS_TIMEOUT_SECONDS=
# AI_ANALYSIS_MAX_OUTPUT_TOKENS=

# --- Storage paths (relative values are anchored to the repository root) ---
# core/paths.py
# MARKET_DATABASE_PATH=
# quantctl/run_history.py
# QUANT_OPERATION_HISTORY_PATH=
# config/paper_store.py: strategy selects the store; overrides per store
# PAPER_STRATEGY_VERSION=
# PAPER_V2_DATABASE_PATH=
# PAPER_V3_DATABASE_PATH=
# Legacy generic store; also written in-process by the V2/V3 wrappers
# PAPER_DATABASE_PATH=

# --- Paper account / sizing / risk / costs (execution/signal_executor.py) --
# PAPER_TRADING_ENABLED=
# PAPER_INITIAL_CASH=
# PAPER_POSITION_SIZER=
# PAPER_RISK_PER_TRADE_PCT=
# PAPER_FIXED_FRACTION_PCT=
# PAPER_ATR_STOP_MULTIPLIER=
# PAPER_ATR_TARGET_MULTIPLIER=
# PAPER_MAX_ORDERS_PER_SCAN=
# PAPER_LOT_SIZE=
# PAPER_COMMISSION_RATE=
# PAPER_SLIPPAGE_BPS=
# PAPER_SELL_TAX_RATE=
# PAPER_MAX_POSITION_PCT=
# PAPER_MAX_EXPOSURE_PCT=
# PAPER_MAX_OPEN_POSITIONS=
# PAPER_MAX_DAILY_LOSS_PCT=
# PAPER_MIN_CASH_BUFFER_PCT=
# PAPER_MAX_ORDER_ADTV20_PCT=

# --- Strategy / execution policy (config/trading_policy.py) ----------------
# TRADING_ENTRY_MODEL=
# TRADING_EXIT_MODEL=
# TRADING_EXECUTION_TIMING=
# TRADING_STOP_ATR_MULTIPLIER=
# TRADING_TARGET_ATR_MULTIPLIER=
# TRADING_TRAILING_ATR_MULTIPLIER=
# TRADING_MAX_HOLDING_DAYS=

# --- Compatibility flags set by wrappers (normally leave unset) ------------
# PAPER_DISABLE_TRAILING=
# PAPER_V2_DISABLE_TRAILING=
# PAPER_V2_ENABLED=
# PAPER_V2_QUALITY_THRESHOLD=

# --- Test-only opt-in -------------------------------------------------------
# Set to 1 to run tests that read the real data/*.db files.
# QUANT_ALLOW_LIVE_DB_TESTS=
